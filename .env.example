# Each binary listens on PORT. Leave it unset and they default to 8080 (web),
# 8081 (api) and 8082 (mcp) so all three can run side by side locally. Set it
# per-container in deployment, where each one is alone.
# PORT=8080

APP_ENV=dev

# Prometheus scrape port, separate from PORT so /metrics is never published
# alongside the application's own routes. Defaults to 9090 (web), 9091 (api)
# and 9092 (mcp) so all three can run locally without colliding.
# METRICS_PORT=9090

# Where clients reach the MCP server. Shown on the /connector page.
MCP_PUBLIC_URL=http://localhost:8082/mcp
